# Copy this file to .env and fill in the values. .env is git-ignored.
# Never commit real values. The app reads these only through app/core/config.py.
# Keep comments on their own lines: some env parsers read a trailing comment as part of the value.

# ---- App ----
# dev | test | prod
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Database and cache ----
# psycopg 3 is the only Postgres driver (SQLAlchemy and the LangGraph checkpointer share it).
DATABASE_URL=postgresql+psycopg://applyiq:applyiq@localhost:5432/applyiq
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# Generate each secret with: openssl rand -hex 32
JWT_SECRET=change-me
CSRF_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# false on http://localhost (Safari drops Secure cookies there). Must be true in prod.
COOKIE_SECURE=false
# Set to false on the public demo to stop new sign-ups.
REGISTRATION_OPEN=true
# IPs allowed to set X-Forwarded-For (the Nginx container in prod).
TRUSTED_PROXY_IPS=127.0.0.1

# ---- LLM ----
# ollama (dev default) | groq (hosted default) | gemini (paid tier or synthetic data only)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# One model per task. Chosen in Phase 2 by running the grounding eval; no model name lives in code.
LLM_MODEL_EXTRACT=
LLM_MODEL_SCORE=
LLM_MODEL_DRAFT=
LLM_MODEL_JUDGE=
GROQ_API_KEY=
GOOGLE_API_KEY=
# Client-side limiter, set below the provider's real limit.
LLM_REQUESTS_PER_MINUTE=20
LLM_TOKENS_PER_MINUTE=6000
LLM_DAILY_TOKEN_BUDGET_PER_USER=100000
LLM_DAILY_TOKEN_BUDGET_GLOBAL=180000

# ---- Job sources ----
# Optional. A free key raises the Himalayas limit to 60 requests a minute. Server-side only.
HIMALAYAS_API_KEY=

# ---- File storage ----
# local in the MVP. An S3 backend is added behind the same interface later.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
MAX_RESUME_PAGES=10

# ---- Tracing ----
# Off by default. With real resumes, inputs and outputs must stay hidden.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=applyiq-dev
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# ---- Product behaviour ----
# Days of silence after "Applied" before a card shows "Follow up".
FOLLOW_UP_DAYS=7
